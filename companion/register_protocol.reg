Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\sidemarks]
@="URL:SideMarks Bridge Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\sidemarks\DefaultIcon]
@="\"%LOCALAPPDATA%\\SideMarksBridge\\SideMarksBridge.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\sidemarks\shell]

[HKEY_CURRENT_USER\Software\Classes\sidemarks\shell\open]

[HKEY_CURRENT_USER\Software\Classes\sidemarks\shell\open\command]
@="\"%LOCALAPPDATA%\\SideMarksBridge\\SideMarksBridge.exe\" \"%1\""
