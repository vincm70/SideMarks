{
  "manifest_version": 3,
  "default_locale": "fr",
  "name": "__MSG_appName__",
  "version": "5.4.0",
  "author": "TOUZIO APPS",
  "description": "__MSG_appDesc__",
  "permissions": [
    "bookmarks",
    "storage",
    "sidePanel",
    "tabs",
    "favicon",
    "unlimitedStorage",
    "identity",
    "alarms",
    "topSites",
    "declarativeNetRequest",
    "notifications"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://tasks.googleapis.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://formsubmit.co/*"
  ],
  "oauth2": {
    "client_id": "266928074814-gfsj5gntbtjo54qi3c9qm852htabc4ve.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly",
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/tasks",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "SideMarks (Alt+B)"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+B",
        "windows": "Alt+B",
        "mac": "Alt+B"
      },
      "description": "Ouvrir ou fermer la barre latérale des favoris"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}